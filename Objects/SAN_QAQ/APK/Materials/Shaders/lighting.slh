inline float getBlinnPhongSpecular(float NdotH, float glossiness)
{
	float glossPower = exp2(glossiness * 12.2877123795495);

	return (glossPower * 0.125 + 0.25) * pow(NdotH, glossPower);
}

inline float3 getBlinnPhongPointLight(float lightRadius, float4 colorFalloff, float3 dirToLight, float3 normal)
{
	float disToLight = length(dirToLight);
	float attenuation = pow(disToLight, -colorFalloff.w) * saturate(dot(normal, dirToLight) / disToLight + step(min(min(colorFalloff.x, colorFalloff.y), colorFalloff.z), -0.001) * 2.0) * _PI_60;

	return colorFalloff.xyz * (-attenuation * smoothstep(lightRadius * 0.95, lightRadius, disToLight) + attenuation);
}
