#if VIEW_AMBIENT
	uniform samplerCUBE diffuseIrradianceMap;
	uniform samplerCUBE specularReflectionMap;

	[auto][a] property float environmentRotation;
	[auto][a] property float2 mipmapLevel;
#endif

float3 directLight(float roughness, float shadow, float NdotL, float NdotV, float NdotH, float VdotH)
{
	float roughnessS = roughness * roughness;
	float NdotLV = NdotL * NdotV;
	float a = (VdotH * VdotH) * (roughness * 2.0) + 0.5;
	float b = roughnessS * roughnessS;
	float c = (NdotH * b - NdotH) * NdotH + 1.0;
	float d = roughness * 0.25 + (b * 0.125 + 0.125);

	return float3(float2(lerp(1.0, a, pow5Exp(NdotL)) * lerp(1.0, a, pow5Exp(NdotV)), NdotLV * b / (lerp(NdotL * c, c, d) * lerp(NdotV * c, c, d) * (NdotLV * 4.0 + 1e-4))) * shadow, a);
}

float3 envBRDFApprox(float3 f0, float roughness, float NdotV)
{
	float4 r = float4(-1.0, -0.0275, -0.572, 0.022) * roughness + float4(1.0, 0.0425, 1.04, -0.04);
	float2 b = float2(-1.04, 1.04) * (min(r.x * r.x, exp2(NdotV * -9.28)) * r.x + r.y) + r.zw;

	return f0 * b.x + b.yyy;
}

inline float3 blendNormal(float3 base, float3 detail)
{
	base.z += 1.0;
	detail.xy *= -1.0;

	return normalize(base * (dot(base, detail) / base.z) - detail);
}

inline float3 getPBR(float3 N, float3 L, float3 V, float3 H, float3 lightColor, float3 baseColor, float metallic, float roughness, float occlusion, float shadow, float3 emissive)
{
	float NdotL = saturate(dot(N, L));
	float NdotV = dot(N, V);
	float NdotH = saturate(dot(N, H));
	float VdotH = saturate(dot(V, H));

	float3 R = N * (NdotV * 2.0) - V;
	NdotV = saturate(NdotV);

	float3 dfgD = directLight(roughness, shadow, NdotL, NdotV, NdotH, VdotH);
	float3 diffuseColor = lerp(baseColor, const0List3, metallic);
	float3 f0 = lerp(float3(0.04, 0.04, 0.04), baseColor, metallic);
	float3 light0 = lightColor * (NdotL * _INVERSE_PI);
	float3 sI = envBRDFApprox(f0, roughness, NdotV);
	float3 sD = lerp(f0, dfgD.zzz, pow5Exp(VdotH));
	float3 dI = -sI * diffuseColor + diffuseColor;
	float3 dD = -sD * diffuseColor + diffuseColor;
	float3 result = const0List3;

	#if VIEW_AMBIENT
		result += texCUBElod(diffuseIrradianceMap, N, 0.0).rgb * dI * occlusion;
		result += texCUBElod(specularReflectionMap, R, log2(roughness) * 1.2 + (mipmapLevel.x - 5.0)).rgb * sI * occlusion;
	#endif

	#if VIEW_DIFFUSE
		result += light0 * dD * dfgD.x;
	#endif

	#if VIEW_SPECULAR
		result += light0 * sD * dfgD.y;
	#endif

	#if EMISSIVE_ALBEDO || EMISSIVE_COLOR || TILED_DECAL_EMISSIVE_ALBEDO || TILED_DECAL_EMISSIVE_COLOR || TILED_DECAL_SPREADING
		result += emissive * 1.5;
	#endif

	return result;
}

inline float3 getPBRPointLight(float3 N, float3 L, float3 V, float3 H, float3 lightColor, float3 baseColor, float metallic, float roughness, float lightRadius, float colorFalloff)
{
	float disToLight = length(L);
	float attenuation = pow(disToLight, -colorFalloff) * 6.0;
	float intensity = -attenuation * smoothstep(lightRadius * 0.95, lightRadius, disToLight) + attenuation;

	L /= disToLight;
	float NdotL = saturate(dot(N, L));
	float NdotV = saturate(dot(N, V));
	float NdotH = saturate(dot(N, H));
	float VdotH = saturate(dot(V, H));

	float3 dfgD = directLight(roughness, 1.0, NdotL, NdotV, NdotH, VdotH);
	float3 diffuseColor = lerp(baseColor, const0List3, metallic);
	float3 f0 = lerp(float3(0.04, 0.04, 0.04), baseColor, metallic);
	float3 light0 = lightColor * (NdotL * intensity);
	float3 sD = lerp(f0, dfgD.zzz, pow5Exp(VdotH));
	float3 dD = -sD * diffuseColor + diffuseColor;
	float3 result = const0List3;

	#if VIEW_DIFFUSE
		result += light0 * dD * dfgD.x;
	#endif

	#if VIEW_SPECULAR
		result += light0 * sD * dfgD.y;
	#endif

	return result;
}
