float4 midPos = mul(float4(projPos.xy, fetchedDepthValue * 2.0 - 1.0, 1.0), invProjMatrix);
float3 eyePos = midPos.xyz / midPos.w;
float3 worldPos = mul(float4(eyePos, 1.0), invViewMatrix).xyz;
float3 localPos = mul(float4(worldPos, 1.0), vecToMat(input.invWorldMatrix0, input.invWorldMatrix1, input.invWorldMatrix2)).xyz;
