float fogDis = length(eyePos);

#if FOG_ATMOSPHERE
	#if ENABLE_HIGH_QUALITY_FOG
		float fogAtmosphereFactory = saturate((dot(eyePos, toLightDir) / (fogDis * toLightDis + 0.001)) * 0.5 + 0.5);
		float3 fogAtmosphereColor = lerp(fogAtmosphereColorSky, fogAtmosphereColorSun, pow(fogAtmosphereFactory, fogAtmosphereScattering));
		output.varFog.rgb = lerp(fogColor, fogAtmosphereColor, saturate(fogDis / fogAtmosphereDistance));
	#else
		output.varFog.rgb = fogAtmosphereColorSky;
	#endif
#else
	output.varFog.rgb = fogColor;
#endif

#if FOG_LINEAR
	output.varFog.a = smoothstep(fogStart, fogEnd, fogDis);
#else
	output.varFog.a = 1.0 - exp2((-fogDensity * fogDensity) * (fogDis * fogDis) * _LOG2_E);
#endif

#if USE_FOG_HALFSPACE
	#if FOG_HALFSPACE_LINEAR
		float fogA = step(camPos.z, fogHalfspaceHeight);
		float fogB = worldPos.z - fogHalfspaceHeight;
		float fogC = fogA * fogB;
		float fogD = fogA * (camPos.z - fogHalfspaceHeight) + fogC;
		float fogE = min(0.0, -fogC * 2.0 + fogB);
		float fogF = fogE / (abs(toCamDir.z) + 0.0001);
		float fogHalfSpaceAmoung = 1.0 - exp2(-fogHalfspaceDensity * length(toCamDir) * (fogE * fogF - fogD));
	#else
		float fogA = fogHalfspaceFalloff * _LOG2_E;
		float fogB = fogHalfspaceHeight - camPos.z;
		float fogC = fogDis / toCamDir.z;
		float fogHalfSpaceAmoung = fogHalfspaceDensity * exp2(fogA * fogB) * (exp2(fogA * toCamDir.z) * fogC - fogC);
	#endif

	output.varFog.a += clamp(fogHalfSpaceAmoung, 0.0, fogHalfspaceLimit);
#endif

output.varFog.a = clamp(output.varFog.a, 0.0, fogLimit);
