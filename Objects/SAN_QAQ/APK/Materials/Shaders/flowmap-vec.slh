#if FLOWMAP
	[material][a] property float flowAnimOffset = 0.0;
	[material][a] property float flowAnimSpeed = 0.0;

	float f = frac(globalTime * flowAnimSpeed);
	float2 flowPhase = float2(f - 0.5, f - step(0.5, f));
	output.flowData = float3(flowPhase * flowAnimOffset, abs(flowPhase.x) * 2.0);
#endif
